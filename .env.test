# Ambiente de testes locais (rodado via `npm test`). Commitado DE PROPÓSITO —
# só contém valores fictícios/dummy, nunca segredos reais, e aponta para um
# endpoint inalcançável (127.0.0.1:1) para a conta.vc, garantindo que os
# testes nunca disparem uma chamada real. Aponta para um banco Postgres
# separado do de desenvolvimento (contagateway_test) para os testes poderem
# criar/apagar dados livremente sem afetar nada real.
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/contagateway_test?schema=public"
WEBHOOK_SECRET="test_webhook_secret_nao_usar_em_producao"
API_KEY="test_api_key_nao_usar_em_producao"
CONTA_VC_USERNAME="test_user"
CONTA_VC_INTENT_URL="http://127.0.0.1:1/nao-deve-ser-chamado-em-teste"
BASE_WSS_RPC_URL="wss://base-rpc.publicnode.com"
RECIPIENT_WALLET_ADDRESS="0x0000000000000000000000000000000000000000"
MAX_PAYMENT_AMOUNT=1000000
BODY_LIMIT_BYTES=102400
