{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["node_modules/.prisma/client/index.d.ts"],
      "@prisma/client/*": ["node_modules/.prisma/client/*"],
      ".prisma/client": ["node_modules/.prisma/client/index.d.ts"],
      ".prisma/client/*": ["node_modules/.prisma/client/*"]
    }
  },
  "include": ["src/**/*"]
}
