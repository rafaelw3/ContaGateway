# ⚠️ OBRIGATÓRIOS antes de rodar (sem eles a aplicação não inicia, ou inicia
# mas nenhuma cobrança nunca liquida): CONTA_VC_USERNAME e
# RECIPIENT_WALLET_ADDRESS, mais abaixo. Depois de configurar, sempre confira
# com `docker compose logs -f app` — se o container ficar reiniciando em
# loop, é sinal de configuração inválida (o log explica exatamente o quê).

# Configurações do Servidor
PORT=3000
HOST=0.0.0.0
# Nível de log (trace|debug|info|warn|error|fatal|silent). Padrão: "debug" fora
# de produção, "info" em produção.
LOG_LEVEL=
# Só habilite se o deploy tiver um proxy reverso confiável na frente (Railway,
# Fly.io, um Nginx/ALB seu). Controla se X-Forwarded-Proto/Host/For são
# confiados para montar URLs e IP do cliente. Valores: "true" (confia em
# qualquer proxy), uma lista de IPs/CIDRs separada por vírgula, ou vazio
# (não confia em nada — padrão seguro).
TRUST_PROXY=

# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/contagateway?schema=public"

# Integração conta.vc
# OBRIGATÓRIO: precisa ser uma conta conta.vc REAL, já existente, com Pix
# habilitado — é o handle que aparece no seu link público
# app.conta.vc/pay/SEU_HANDLE. Sem uma conta real, toda tentativa de criar
# cobrança retorna 502 (a conta.vc responde 404 para handles inexistentes).
CONTA_VC_USERNAME="MEU_USUARIO"
CONTA_VC_INTENT_URL="https://app.conta.vc/api/pay/intent"

# Oráculo Web3 (Rede Base)
# Padrão: RPC público e gratuito da PublicNode, sem chave/conta necessária.
# Bom pra desenvolvimento e volume baixo, mas é um endpoint compartilhado —
# sem SLA, sujeito a rate limit e instabilidade sob carga. Para produção com
# volume real, troque por um provedor pago com WSS dedicado (ex: Alchemy —
# wss://base-mainnet.g.alchemy.com/v2/SEU_API_KEY, Infura, QuickNode etc.).
BASE_WSS_RPC_URL="wss://base-rpc.publicnode.com"
# OBRIGATÓRIO: endereço real da sua carteira na Base (a mesma cadastrada na
# conta.vc, que recebe o cBRL). Encontrado no painel da conta.vc em
# Configurações > Segurança. NÃO é um placeholder opcional — deixar o
# endereço zero abaixo faz o servidor recusar iniciar (falha rápido de
# propósito, para nunca rodar "liquidando" sem ninguém realmente recebendo).
RECIPIENT_WALLET_ADDRESS="0x0000000000000000000000000000000000000000"
# Nº de confirmações de bloco exigidas antes de liquidar um pagamento (mitiga reorgs)
WEB3_REQUIRED_CONFIRMATIONS=3
# Janela de carência (ms) após uma cobrança expirar em que um mint de cBRL
# correspondente ainda liquida o pagamento (status vai de EXPIRED -> PAID).
# Cobre o caso do pagador pagar o Pix nos últimos segundos do prazo e a
# liquidação on-chain chegar minutos depois. Padrão: 30 minutos.
SETTLEMENT_GRACE_PERIOD_MS=1800000
# Tempo médio de bloco da rede (ms), usado só para calibrar o atraso do retry de confirmação
WEB3_BLOCK_TIME_MS=2000
# Varredura de recuperação a partir do checkpoint salvo no banco (ver README,
# "Sincronização Histórica"): intervalo da varredura periódica (ms), quanto no
# máximo voltar depois de uma queda longa (blocos; ~7 dias na Base) e quantos
# blocos por chamada getLogs (reduza se o provedor de RPC recusar o intervalo).
WEB3_SYNC_INTERVAL_MS=60000
WEB3_SYNC_MAX_LOOKBACK_BLOCKS=302400
WEB3_SYNC_CHUNK_BLOCKS=2000

# cBRL é o token que de fato representa o valor liquidado (ver README: "Por
# que cBRL e não BRLA?") — normalmente não precisa mexer nesses dois:
CBRL_CONTRACT_ADDRESS="0x37422aE25c0f54442381eEA8406812cbe1Ab8A62"
CBRL_DECIMALS=18
# Só defina se a carteira que deve receber o cBRL for diferente de
# RECIPIENT_WALLET_ADDRESS (raro — normalmente são a mesma carteira).
EXPECTED_CBRL_WALLET_ADDRESS=

# BRLA agora é só um sinal de diagnóstico OPCIONAL (nunca decide liquidação).
# Deixe BRLA_RESERVE_ADDRESS em branco para desativar esse monitoramento extra.
BRLA_CONTRACT_ADDRESS="0xfCB34c47f850f452C15EA1B84d51231C38A61783"
BRLA_DECIMALS=18
BRLA_RESERVE_ADDRESS=

# Webhooks de Saída
WEBHOOK_SECRET="cgw_sec_coloque_sua_chave_secreta_aqui"
WEBHOOK_MAX_RETRIES=3

# Segurança e Autenticação da API
# Uma ou mais chaves separadas por vírgula. Para trocar a chave sem downtime:
# API_KEY="nova,antiga" → integradores passam a usar a nova → remova a antiga.
API_KEY="cgw_live_coloque_sua_chave_de_api_aqui"
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
EXPIRATION_WORKER_INTERVAL_MS=60000

# Observabilidade (Sentry)
# DSN do projeto em https://sentry.io — deixe em branco para desativar (não quebra nada).
SENTRY_DSN=
# Rótulo de ambiente mostrado no Sentry. Padrão: NODE_ENV.
SENTRY_ENVIRONMENT=

# Alerta de mudança de contrato da conta.vc (endpoint interno, sem suporte —
# ver ARCHITECTURE.md seção 1). Se a resposta de /api/pay/intent sair do formato
# esperado, o ContaGateway sempre loga um alerta (funciona em qualquer
# ambiente, sem configuração). Preencha esta URL só se quiser ALÉM disso um
# push ativo — útil pra quem não usa Sentry. Aceita Slack Incoming Webhook,
# Discord Incoming Webhook, ou o node "Webhook" de um workflow n8n (recebe o
# JSON cru e você decide o que fazer). Dá pra configurar VÁRIOS destinos ao
# mesmo tempo, separados por vírgula, ex:
# OPS_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/...,https://meu-n8n.exemplo.com/webhook/..."
# Deixe em branco para desativar esse canal extra.
OPS_ALERT_WEBHOOK_URL=

# Limites específicos anti-DoS (sobrepõem o rate limit global nas rotas mais caras)
MAX_PAYMENT_AMOUNT=1000000
BODY_LIMIT_BYTES=102400
PAYMENT_CREATE_RATE_LIMIT_MAX=30
QRCODE_RATE_LIMIT_MAX=20
PAY_PAGE_RATE_LIMIT_MAX=30
# Reenvio manual de webhook por operador (rota autenticada, limite conservador)
WEBHOOK_RETRY_RATE_LIMIT_MAX=5

# Redis (opcional) — necessário apenas ao escalar para múltiplas instâncias.
# Sem esta variável, o rate limit opera em memória (adequado para instância única).
# Exemplo Railway: redis://default:senha@redis.railway.internal:6379
# Exemplo local:   redis://localhost:6379
REDIS_URL=
