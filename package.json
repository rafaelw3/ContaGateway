{
  "name": "conta-gateway",
  "version": "1.0.0",
  "type": "module",
  "description": "Payment gateway that settles Brazilian Pix charges on-chain (cBRL on Base) via conta.vc, with signed webhooks",
  "main": "dist/server.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelw3/ContaGateway.git"
  },
  "homepage": "https://github.com/rafaelw3/ContaGateway#readme",
  "keywords": [
    "pix",
    "payments",
    "payment-gateway",
    "base",
    "cbrl",
    "stablecoin",
    "web3",
    "viem",
    "fastify",
    "prisma",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "probe:contavc": "tsx scripts/probe-contavc.ts",
    "webhook:resend": "tsx scripts/resend-webhook.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "dev": "tsx watch --import ./src/instrument.ts src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "start": "node --import ./dist/instrument.js dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:migrate": "dotenv -e .env.test -- prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/redis": "^9.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.74.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.4",
    "ioredis": "^6.0.0",
    "pino": "^9.14.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@vitest/mocker": "4.1.11"
  }
}
